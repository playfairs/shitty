project "shitty" {
    description = "A rather shitty shell."
    license = file("./UNLICENSE")

    executable "shit" {
        sources = [
            "src/core/main.c",
            "src/core/shell.c",
            "src/parsing/lexer.c",
            "src/parsing/parser.c",
            "src/execution/executor.c",
            "src/expansion/expansion.c",
            "src/history/history.c",
            "src/input/input.c",
            "src/terminal/terminal.c",
            "src/prompt/prompt.c",
            "src/builtin/registry.c",
            "src/builtin/cd.c",
            "src/builtin/pwd.c",
            "src/builtin/exit.c",
            "src/environment/environment.c",
            "src/signals/signals.c"
        ]
        include_dirs = ["include"]
        flags = [
            "-std=c17",
            "-D_POSIX_C_SOURCE=200809L",
            "-Wall",
            "-Wextra",
            "-Wpedantic",
            "-Werror"
        ]
        install = true
    }
}